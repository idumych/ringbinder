#!/bin/sh
# Ringbinder AppImage entry point. Cosmoe finds its add-ons and data next to
# usr/lib/libbe.so, and Ringbinder finds libbe through its RUNPATH; this sets
# up the rest:
#  - fontconfig, for the bundled Noto fonts;
#  - TRANSLATORS, the image translators to load. Cosmoe's default lookup
#    misses the bundled ones on the very first run from a mounted AppImage,
#    so name them directly;
#  - the CA certificate bundle for Google sync. The bundled libcurl only
#    knows the path of the distro it was built on, and distros differ.
HERE=$(dirname "$(readlink -f "$0")")
export FONTCONFIG_FILE="$HERE/etc/fonts/fonts.conf"
export TRANSLATORS="$HERE/usr/lib/addons/Translators"
if [ -z "${CURL_CA_BUNDLE:-}" ]; then
	for ca in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt \
			/etc/ssl/ca-bundle.pem /etc/ssl/cert.pem; do
		if [ -r "$ca" ]; then
			export CURL_CA_BUNDLE="$ca"
			break
		fi
	done
fi
exec "$HERE/usr/bin/Ringbinder" "$@"
