#!/bin/sh
# Ringbinder postinst: dpkg does not keep extended attributes, and VitruvianOS
# stores BeOS attributes (app signature, flags, version, file types) as
# user.beos.* xattrs. Restore them onto the installed binary from the
# attribute tarball, the same way the vos package does for its own apps.
set -e

case "$1" in
	configure) ;;
	abort-upgrade|abort-remove|abort-deconfigure) exit 0 ;;
	*) exit 0 ;;
esac

APP=/system/apps/Ringbinder
ATTRS=/usr/share/ringbinder/apps_attrs.tar

if [ -f "$ATTRS" ] && [ -f "$APP" ] \
		&& command -v getfattr >/dev/null 2>&1 \
		&& command -v setfattr >/dev/null 2>&1; then
	_tmp=$(mktemp -d)
	if tar --xattrs --xattrs-include='user.*' -xf "$ATTRS" -C "$_tmp"; then
		# getfattr prints "# file: system/apps/Ringbinder"; restoring from / puts
		# the attributes on the real binary.
		( cd "$_tmp" && getfattr --absolute-names -d -m '^user\.beos\.' \
				-e hex system/apps/Ringbinder ) \
			| ( cd / && setfattr --restore=- ) || true
	fi
	rm -rf "$_tmp"
fi

# Let the registrar learn the signature and file types now, if it runs.
if command -v mimeset >/dev/null 2>&1; then
	timeout 20 mimeset -f "$APP" >/dev/null 2>&1 || true
fi

exit 0
